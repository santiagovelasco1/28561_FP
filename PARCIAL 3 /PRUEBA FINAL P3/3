#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main()
{
    int minimo, maximo;
    int secreto;
    int intentosMax;
    int intento;
    int matriz[10][3];
    int i, j;
    int repetido;
    int adivino = 0;

    srand(time(NULL));

    // ===========================
    // RF01: Configuración dinámica del rango
    // El usuario ingresa el valor mínimo y máximo.
    // ===========================

    printf("Ingrese el valor minimo: ");
    scanf("%d", &minimo);

    printf("Ingrese el valor maximo: ");
    scanf("%d", &maximo);

    while(minimo >= maximo)
    {
        printf("\nERROR. El minimo debe ser menor que el maximo.\n");

        printf("Ingrese el valor minimo: ");
        scanf("%d", &minimo);

        printf("Ingrese el valor maximo: ");
        scanf("%d", &maximo);
    }

    secreto = rand() % (maximo - minimo + 1) + minimo;

    // ===========================
    // RF02: Configuración dinámica de intentos
    // El usuario selecciona la cantidad de intentos (1-10).
    // ===========================

    printf("\nCantidad maxima de intentos (1-10): ");
    scanf("%d", &intentosMax);

    while(intentosMax < 1 || intentosMax > 10)
    {
        printf("Valor incorrecto. Ingrese un valor entre 1 y 10: ");
        scanf("%d", &intentosMax);
    }

    for(i=0; i<intentosMax; i++)
    {
        do
        {
            repetido = 0;

            printf("\nIntento %d: ", i+1);
            scanf("%d", &intento);

            // ===========================
            // RF03: Validación del rango
            // Verifica que el número esté dentro del rango.
            // ===========================

            if(intento < minimo || intento > maximo)
            {
                printf("Numero fuera del rango.\n");
                repetido = 1;
                continue;
            }

            // ===========================
            // RF03: Validación de duplicados
            // Verifica que el número no haya sido ingresado antes.
            // ===========================

            for(j=0; j<i; j++)
            {
                if(intento == matriz[j][1])
                {
                    repetido = 1;
                    printf("Numero repetido.\n");
                    break;
                }
            }

        }while(repetido == 1);

        // ===========================
        // RF04: Registro de intentos en matriz
        // Columna 0 = Número de intento
        // Columna 1 = Valor ingresado
        // Columna 2 = Resultado
        // 0 = Bajo
        // 1 = Alto
        // 2 = Correcto
        // ===========================

        matriz[i][0] = i + 1;
        matriz[i][1] = intento;

        if(intento < secreto)
        {
            matriz[i][2] = 0;
            printf("Muy bajo.\n");
        }
        else if(intento > secreto)
        {
            matriz[i][2] = 1;
            printf("Muy alto.\n");
        }
        else
        {
            matriz[i][2] = 2;
            printf("Correcto.\n");
            adivino = 1;
            i++;
            break;
        }
    }

    // ===========================
    // RF05: Visualización del resumen
    // Muestra la tabla con todos los intentos
    // y el resultado textual.
    // ===========================

    printf("\n=========================================\n");
    printf("RESUMEN DE INTENTOS\n");
    printf("=========================================\n");
    printf("Intento\tNumero\tResultado\n");

    for(j=0; j<i; j++)
    {
        printf("%d\t%d\t", matriz[j][0], matriz[j][1]);

        if(matriz[j][2] == 0)
            printf("Bajo");

        if(matriz[j][2] == 1)
            printf("Alto");

        if(matriz[j][2] == 2)
            printf("Correcto");

        printf("\n");
    }

    // ===========================
    // RF05: Si el usuario no adivina,
    // revelar el número secreto.
    // ===========================

    if(adivino == 0)
    {
        printf("\nNo adivinaste el numero.\n");
        printf("El numero secreto era: %d\n", secreto);
    }
    else
    {
        printf("\nFelicidades. Adivinaste el numero.\n");
    }

    return 0;
}
